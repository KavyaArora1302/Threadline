# Copy to .env and fill in. .env is gitignored and must never be committed.

# ---------------------------------------------------------------------------
# Needed by the running app
# ---------------------------------------------------------------------------

# Signs the session cookie. Generate a long random value, and use a DIFFERENT
# one in production than locally:
#   python -c "import secrets; print(secrets.token_urlsafe(48))"
SESSION_SECRET_KEY=

# Where chats and user accounts are stored. Leave BLANK for local development
# and Threadline uses data/threadline.db (SQLite), no setup required. Set it to
# a Postgres URL — as the deployed app does — and that is used instead. Paste a
# provider's URL exactly as given; app/db.py normalises the driver prefix.
DATABASE_URL=

# "production" makes the session cookie HTTPS-only. Leave blank/unset locally,
# where there is no HTTPS and setting it would stop login working.
ENVIRONMENT=

# AI providers that answer questions (app/search/models.py)
GEMINI_API_KEY=
GROQ_API_KEY=

# ---------------------------------------------------------------------------
# Only needed to re-ingest data (app/ingestion/*). The running server never
# imports those modules, so the deployed app does not need any of these.
# ---------------------------------------------------------------------------
GITHUB_TOKEN=
JIRA_API_TOKEN=
JIRA_EMAIL=
JIRA_SITE=
SLACK_BOT_TOKEN=
SLACK_CHANNEL=
